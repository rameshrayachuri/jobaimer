# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development     # development | test | production

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# Local only — Lambda/ECS use IAM roles in prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RESUME_BUCKET=jobaimer-resumes-dev

# ── AWS Cognito (replaces Supabase Auth) ───────────────────────────────────────
# Create User Pool in AWS Console → Cognito → User Pools
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=                      # leave blank for public client
COGNITO_REGION=us-east-1

# ── Neon Postgres (replaces Supabase DB) ───────────────────────────────────────
# Get from: https://console.neon.tech → project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
ADMIN_DATABASE_URL=postgresql://user:password@ep-yyy.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8000

# ── Temporal ───────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=jobaimer-dev
TEMPORAL_TASK_QUEUE=jobaimer-main

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_STARTER_MONTHLY_PRICE_ID=price_
STRIPE_STARTER_ANNUAL_PRICE_ID=price_
STRIPE_PRO_MONTHLY_PRICE_ID=price_
STRIPE_PRO_ANNUAL_PRICE_ID=price_

# ── App secrets ────────────────────────────────────────────────────────────────
API_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM
ADMIN_SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM
ADMIN_IP_ALLOWLIST=127.0.0.1/32,10.0.0.0/8

# ── Email / SMS ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_
FROM_EMAIL=noreply@jobaimer.com

# ── Agent tuning ───────────────────────────────────────────────────────────────
MAX_JOBS_PER_CYCLE=20
MAX_JOBS_PER_DAY=50
APPLY_CYCLE_HOURS=4
BROWSER_HEADLESS=true

# ── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend (Vite — prefix with VITE_) ───────────────────────────────────────
# These go in frontend/.env  (safe to expose — no Supabase keys needed)
VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
