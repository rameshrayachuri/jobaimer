# ── Environment ────────────────────────────────────────
ENVIRONMENT=development    # development | test | production

# ── AWS ────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# Local only — Lambda/ECS use IAM roles in prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RESUME_BUCKET=jobaimer-resumes-dev

# ── Supabase (User App) ────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Supabase (Admin — SEPARATE project) ───────────────
ADMIN_SUPABASE_URL=https://YOUR_ADMIN_REF.supabase.co
ADMIN_SUPABASE_ANON_KEY=
ADMIN_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SUPABASE_DB_URL=

# ── Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8000

# ── Temporal ───────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=jobaimer-dev
TEMPORAL_TASK_QUEUE=jobaimer-main

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_STARTER_MONTHLY_PRICE_ID=price_
STRIPE_STARTER_ANNUAL_PRICE_ID=price_
STRIPE_PRO_MONTHLY_PRICE_ID=price_
STRIPE_PRO_ANNUAL_PRICE_ID=price_

# ── App secrets ────────────────────────────────────────
API_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM
ADMIN_SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM
ADMIN_IP_ALLOWLIST=127.0.0.1/32,10.0.0.0/8

# ── Email / SMS ────────────────────────────────────────
RESEND_API_KEY=re_
FROM_EMAIL=noreply@jobaimer.com

# ── Agent tuning ───────────────────────────────────────
MAX_JOBS_PER_CYCLE=20
MAX_JOBS_PER_DAY=50
APPLY_CYCLE_HOURS=4
BROWSER_HEADLESS=true

# ── Observability ──────────────────────────────────────
SENTRY_DSN=

# ── Frontend (Vite — prefix with VITE_) ───────────────
# These go in frontend/.env  (safe to expose — RLS enforced)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
